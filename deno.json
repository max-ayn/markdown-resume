{
  "exclude": [
    "research/**/*.ipynb"
  ],
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "build": "deno run -A src/main.ts",
    "build:pdf": "deno run -A src/main.ts --pdf"
  },
  "imports": {
    "@docling/docling-core": "npm:@docling/docling-core@^0.0.7",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@^1.1.4",
    "playwright": "npm:playwright@^1.58.2"
  },
  "nodeModulesDir": "auto"
}
